  },
  {
   "title": "Flood-prone ground: JRC Global Surface Water; Global Flood Database; Sentinel-1 flood extent (Copernicus)"
  },
  {
   "title": "Displacement: IOM Displacement Tracking Matrix records compiled in data/flood_displacement_county_month.csv"
  }
 ],
