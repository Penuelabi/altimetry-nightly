# Copy to .env for local runs. In the cloud, set these as environment secrets — never commit real values.
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
# Signs session tokens. Any long random string: `openssl rand -base64 48`.
SESSION_SECRET=

# Google: one service account for Drive, Sheets and Earth Engine (paste the whole JSON on one line).
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=1EyYopiOghPmHyJyBuH8DCp9PJv1zvCzV
SHEET_ID=
GEE_PROJECT=
# Prefix with ic: if the asset is an ImageCollection (latest image is used).
GEE_SOIL_MOISTURE_ASSET=
GEE_SOIL_MOISTURE_BAND=
GEE_FLOOD_EXTENT_ASSET=

# GitHub: private repo holding users.json (hashed keys), gauge readings and config.
GITHUB_ACCESS_REPO=owner/abuk-access
GITHUB_TOKEN=
GITHUB_BRANCH=main

# SMS: africastalking or twilio. For Twilio, SMS_USERNAME is the account SID and SMS_API_KEY the auth token.
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=
SMS_WEBHOOK_SECRET=
